# =============================================================================
# NexusRAG configuration
# Copy to `.env` and fill in the secrets. Everything except GEMINI_API_KEY is
# optional: defaults live in src/nexusrag/config.py. Comments are kept on their
# own lines because Docker's --env-file does not strip inline comments.
# =============================================================================

# ----------------------------------------------------------------- runtime
# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# console (pretty, local) | json (deployed environments)
LOG_FORMAT=console
# true logs prompts, queries and document text. Local debugging only.
LOG_CONTENT=false

# ----------------------------------------------------------------- gemini
# REQUIRED. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Main answer model / cheaper model for rewriting, routing and grading.
GENERATION_MODEL=gemini-3.8-flash
FAST_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# 128-3072; 768, 1536 and 3072 are the recommended sizes.
# Changing this requires re-indexing all documents.
EMBEDDING_DIM=768
# auto | prefix | task_type (auto: prefixes for gemini-embedding-2, task_type for -001)
EMBEDDING_INPUT_MODE=auto
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
# minimal | low | medium | high | none (none = model default).
# gemini-3.8-flash does not support "minimal".
GENERATION_THINKING_LEVEL=low
FAST_THINKING_LEVEL=none
# Leave empty: Gemini 3 models are tuned for their default temperature (1.0).
GENERATION_TEMPERATURE=
FAST_TEMPERATURE=
MAX_OUTPUT_TOKENS=8192
LLM_TIMEOUT_S=60
LLM_MAX_ATTEMPTS=5
LLM_RETRY_INITIAL_WAIT_S=1.0
LLM_RETRY_MAX_WAIT_S=30.0
# Optional JSON override of the USD-per-1M-token price table used for cost logs:
# LLM_PRICES={"gemini-3.8-flash": {"input_per_m": 0.75, "output_per_m": 3.75}}

# ----------------------------------------------------------------- storage
DATA_DIR=data
STORAGE_DIR=storage
DEFAULT_COLLECTION=default

# ----------------------------------------------------------------- chunking (tokens)
CHILD_CHUNK_TOKENS=256
CHILD_CHUNK_OVERLAP=40
PARENT_CHUNK_TOKENS=1200

# ----------------------------------------------------------------- retrieval
TOP_K=5
DENSE_K=20
BM25_K=20
RRF_K=60
ENABLE_HYBRID=true
ENABLE_MULTI_QUERY=true
NUM_QUERY_VARIANTS=3
ENABLE_HYDE=false
ENABLE_RERANK=true
# cross_encoder (local BAAI/bge-reranker-base) | gemini (LLM-as-reranker fallback)
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_MAX_LENGTH=512
# Rescore only the top N fused candidates (cross-encoders are slow).
RERANK_CANDIDATES=20
# Drop candidates scoring below this (0-1). Nothing left => "not in your documents".
RERANK_THRESHOLD=0.1
CONTEXT_TOKEN_BUDGET=6000
HISTORY_TURNS=6

# ----------------------------------------------------------------- agent
ENABLE_SELF_CORRECTION=true
MAX_RETRIEVAL_RETRIES=2

# ----------------------------------------------------------------- semantic cache
ENABLE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.95

# ----------------------------------------------------------------- UI / security
AUTH_USERNAME=admin
# REQUIRED in staging/production.
AUTH_PASSWORD=
# REQUIRED when auth is enabled. Generate with: chainlit create-secret
CHAINLIT_AUTH_SECRET=
MAX_UPLOAD_FILES=10
MAX_UPLOAD_MB=20
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_HOUR=30
