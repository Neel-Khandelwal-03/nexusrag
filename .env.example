# =============================================================================
# NexusRAG configuration
#
# Copy to `.env` and fill in GEMINI_API_KEY. That's all you need locally.
#
# Every other setting is commented out on purpose: the defaults live in
# src/nexusrag/config.py and get tuned over time (e.g. RERANK_THRESHOLD was
# calibrated against real reranker scores). Uncomment only the values you want
# to change; otherwise your .env would pin today's defaults forever.
#
# Comments sit on their own lines because Docker's --env-file doesn't strip
# inline comments.
# =============================================================================

# ----------------------------------------------------------------- secrets
# REQUIRED. Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# REQUIRED in staging/production (password login). Locally, leaving it empty lets
# AUTH_USERNAME log in with any password.
AUTH_PASSWORD=
# REQUIRED in staging/production: signs login sessions. Generate with: chainlit create-secret
# Locally a temporary one is generated when empty (you're logged out on restart).
CHAINLIT_AUTH_SECRET=

# ----------------------------------------------------------------- runtime
# development | test | staging | production
# ENVIRONMENT=development
# LOG_LEVEL=INFO
# console (pretty, local) | json (deployed environments)
# LOG_FORMAT=console
# true logs prompts, queries and document text. Local debugging only.
# LOG_CONTENT=false

# ----------------------------------------------------------------- gemini models
# Main answer model / cheaper model for rewriting, routing and grading.
# GENERATION_MODEL=gemini-3.8-flash
# FAST_MODEL=gemini-3.5-flash-lite
# Backup models when the primary is overloaded (429/5xx after retries) or retired (404).
# Set to none to disable. Embeddings never fall back (vectors must match the index).
# GENERATION_FALLBACK_MODEL=gemini-3.6-flash
# FAST_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY can also be supplied as GOOGLE_API_KEY.
# EMBEDDING_MODEL=gemini-embedding-2
# 128-3072; 768, 1536 and 3072 are the recommended sizes. Changing it requires re-indexing.
# EMBEDDING_DIM=768
# auto | prefix | task_type (auto: prefixes for gemini-embedding-2, task_type for -001)
# EMBEDDING_INPUT_MODE=auto
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_CONCURRENCY=4
# minimal | low | medium | high | none (none = model default). gemini-3.8-flash rejects "minimal".
# GENERATION_THINKING_LEVEL=low
# FAST_THINKING_LEVEL=none
# Leave unset: Gemini 3 models are tuned for their default temperature (1.0).
# GENERATION_TEMPERATURE=
# FAST_TEMPERATURE=
# MAX_OUTPUT_TOKENS=8192
# LLM_TIMEOUT_S=60
# Attempts per model (a fallback model gets its own attempts).
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_INITIAL_WAIT_S=1.0
# LLM_RETRY_MAX_WAIT_S=8.0
# JSON override of the USD-per-1M-token price table used for cost logs:
# LLM_PRICES={"gemini-3.8-flash": {"input_per_m": 0.75, "output_per_m": 3.75}}

# ----------------------------------------------------------------- storage
# DATA_DIR=data
# STORAGE_DIR=storage
# DEFAULT_COLLECTION=default

# ----------------------------------------------------------------- chunking (tokens)
# CHILD_CHUNK_TOKENS=256
# CHILD_CHUNK_OVERLAP=40
# PARENT_CHUNK_TOKENS=1200

# ----------------------------------------------------------------- retrieval
# TOP_K=5
# DENSE_K=20
# BM25_K=20
# RRF_K=60
# ENABLE_HYBRID=true
# ENABLE_MULTI_QUERY=true
# NUM_QUERY_VARIANTS=3
# ENABLE_HYDE=false
# ENABLE_RERANK=true
# cross_encoder (local BAAI/bge-reranker-base) | gemini (LLM-as-reranker fallback)
# RERANKER_BACKEND=cross_encoder
# RERANKER_MODEL=BAAI/bge-reranker-base
# RERANKER_MAX_LENGTH=512
# Rescore only the top N fused candidates (cross-encoders are slow).
# RERANK_CANDIDATES=20
# Drop candidates scoring below this (0-1). Nothing left => "not in your documents".
# RERANK_THRESHOLD=0.1
# Weight of the hybrid ranking when fused with the reranker order (0 = pure reranker order).
# RERANK_FUSION_WEIGHT=1.0
# CONTEXT_TOKEN_BUDGET=6000
# Previous chat messages (user + assistant) used to condense follow-up questions.
# HISTORY_TURNS=6

# ----------------------------------------------------------------- agent
# ENABLE_SELF_CORRECTION=true
# MAX_RETRIEVAL_RETRIES=2
# Summaries: single call up to this size (tokens), map-reduce in batches of the second.
# SUMMARY_STUFF_TOKENS=12000
# SUMMARY_MAP_BATCH_TOKENS=6000
# Comparisons: chunks retrieved per document, and max documents per comparison.
# COMPARE_TOP_K_PER_DOC=4
# MAX_COMPARE_DOCUMENTS=4

# ----------------------------------------------------------------- semantic cache
# ENABLE_SEMANTIC_CACHE=true
# CACHE_SIMILARITY_THRESHOLD=0.95

# ----------------------------------------------------------------- UI / security
# Suggest 2-3 follow-up questions after grounded answers (one fast-model call).
# ENABLE_FOLLOW_UPS=true
# AUTH_USERNAME=admin
# MAX_UPLOAD_FILES=10
# MAX_UPLOAD_MB=20
# RATE_LIMIT_MESSAGES_PER_MINUTE=20
# RATE_LIMIT_UPLOADS_PER_HOUR=30
